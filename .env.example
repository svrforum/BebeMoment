# Bebe Moment — 개발(dev) 환경변수 예시
# ⚠️ 프로덕션(Docker / Synology)은 이 파일이 아니라 compose/.env.example 을 쓰세요.
# 이 파일은 로컬에서 `pnpm dev`(web:3000 + media:3001 을 각각)로 띄울 때의 예시입니다.

# === 필수 ===
DATABASE_URL=postgres://bebe:bebe@localhost:5432/bebe
REDIS_URL=redis://localhost:6379
# 32바이트 이상 (생성: openssl rand -hex 32)
SECRET_KEY=dev_secret_key_at_least_32_bytes_long_change_me
PUBLIC_URL=http://localhost:3000

# === Media 서비스 (web → media) ===
# dev 는 단일 컨테이너가 아니라 web·media 를 따로 띄운다. web 의 /media/* 는
# Next rewrite(next.config.mjs)가 MEDIA_INTERNAL_URL 로 프록시한다.
MEDIA_INTERNAL_URL=http://localhost:3001
# 서비스 간 정적 토큰 + 업로드/조회 JWT 서명키 (각 32바이트+)
MEDIA_SERVICE_TOKEN=dev_media_service_token_at_least_32_bytes_____
MEDIA_JWT_SECRET=dev_media_jwt_secret_at_least_32_bytes________

# === dev 옵션 ===
NODE_ENV=development
LOG_LEVEL=debug

# MEDIA_PUBLIC_BASE_URL / NEXT_PUBLIC_MEDIA_BASE_URL 은 미설정으로 둔다 → 미디어 URL 이
# 상대경로(/media/*)가 되어 브라우저가 현재 오리진으로 가져간다. 미디어를 별도 호스트로
# 분리할 때만 절대 URL 을 넣는다.
# 저사양 ARM 에서 AVIF 인코딩을 끄려면: MEDIA_DERIVATIVES_INCLUDE_AVIF=false
#
# DB role 분리(bebe_web / bebe_media)는 프로덕션 전용 — dev 는 DATABASE_URL(bebe) 하나로
# 충분하다(미설정 시 DATABASE_URL_WEB/MEDIA 가 DATABASE_URL 로 폴백). compose/.env.example 참고.

# === 튜닝 노브 (전부 선택, 기본값 표시 — 전체 표는 docs/operations.md "Tuning knobs") ===
# TRUST_PROXY=true                  # 프록시 뒤가 아니면 false (레이트리밋 IP 판단)
# SHARE_ALLOWED_HOSTS=              # 공유 링크 미리보기에 신뢰할 추가 호스트(쉼표)
# SETUP_TOKEN=                      # 최초 가입 잠금(/signup?setup=…)
# OIDC_ALLOW_LOCAL_FETCH=false      # LAN/사설 IP 의 IdP 를 쓸 때만 true (SSRF 가드 해제)
# SSE_MAX_PER_USER=5                # 사용자당 동시 업로드 진행 스트림 수
# MEDIA_URL_CACHE=on                # web 쪽 서명 URL 캐시, off 로 비활성
# MEDIA_CONCURRENCY_THUMBNAIL=3     # 동시에 처리하는 사진 파생물 잡
# MEDIA_MAX_UPLOAD_BYTES=5368709120 # 파일 하나 상한(5GiB)
# MEDIA_FAMILY_QUOTA_BYTES=0        # 가족 전체 상한, 0=무제한
# MEDIA_MAX_INPUT_PIXELS=64000000   # 이보다 큰 이미지는 거부
# MEDIA_STALE_UPLOAD_HOURS=6        # 멈춘 업로드를 failed 처리하기까지
# MEDIA_STALE_PROCESSING_HOURS=12   # 멈춘 processing 을 failed 처리하기까지
# MEDIA_SHUTDOWN_GRACE_MS=30000     # 종료 시 진행 중 트랜스코드에 주는 시간
