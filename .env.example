# === 공통 (웹/미디어 양쪽) ===
# DATABASE_URL 은 마이그레이션·entrypoint 에서 superuser 연결용.
# 런타임은 role 별로 DATABASE_URL_WEB / DATABASE_URL_MEDIA 를 우선 사용.
DATABASE_URL=postgres://bebe:bebe@localhost:5432/bebe
DATABASE_URL_WEB=postgres://bebe_web:CHANGE_ME@localhost:5432/bebe
DATABASE_URL_MEDIA=postgres://bebe_media:CHANGE_ME@localhost:5432/bebe
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-32-plus-bytes
PUBLIC_URL=http://localhost:3000

# === Media 서비스 ===
# 웹 → 미디어 내부 호출 (컨테이너 내 DNS: http://media:3001)
MEDIA_INTERNAL_URL=http://media:3001
# 사용자 브라우저에서 미디어로 접근 — Compose 에서는 Caddy 가 /media/* 를 media:3001 로 라우팅
# (dev 로컬에서 web/media 직접 띄울 때만 http://localhost:3001 로 바꿔 사용)
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000
# 서비스 간 HMAC-SHA256 정적 토큰 (32+ bytes)
MEDIA_SERVICE_TOKEN=change-me-32-plus-bytes
# 업로드/다운로드 JWT 서명 비밀키 (32+ bytes)
MEDIA_JWT_SECRET=change-me-32-plus-bytes

# === DB role 비밀번호 (entrypoint 가 ALTER ROLE 로 반영) ===
BEBE_WEB_DB_PASSWORD=CHANGE_ME
BEBE_MEDIA_DB_PASSWORD=CHANGE_ME

# Phase C-2: AVIF 인코딩 비활성화 (ARM NAS 부담 시)
# AVIF encode 가 sharp 에서 가장 비싼 인코더 — 저사양 ARM에서는 'false' 권장.
# 비활성화하면 WebP+JPEG 만 생성 (PictureImage 가 자동 폴백).
# MEDIA_DERIVATIVES_INCLUDE_AVIF=false
