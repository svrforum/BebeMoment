# Required
SECRET_KEY=change-me-to-32-plus-random-bytes-64-hex-recommended
POSTGRES_PASSWORD=change-me-too
PUBLIC_URL=https://bebe.example.com

# Optional
PORT=3000
DATA_DIR=./data
PG_DIR=./pg
REDIS_DIR=./redis
PUID=1000
PGID=1000

# Admin
ADMIN_USER_EMAIL=you@example.com

# Storage mode (default local)
STORAGE_MODE=local
# STORAGE_MODE=s3
# STORAGE_S3_ENDPOINT=https://minio.example.com
# STORAGE_S3_BUCKET=bebe
# STORAGE_S3_ACCESS_KEY=...
# STORAGE_S3_SECRET_KEY=...
# STORAGE_S3_REGION=us-east-1

# Image tag
TAG=latest
GITHUB_REPO=svrforum/bebe-moment

# Logs
LOG_LEVEL=info

# Resource limits (optional)
WEB_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=1536m
PG_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=128m
