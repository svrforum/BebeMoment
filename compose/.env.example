# ── Required ───────────────────────────────────────────────
# ⚠️ 아래 시크릿은 반드시 직접 생성하세요. 예시/자리표시자(change-me…) 값은 길이는
#    채워도 **프로덕션에서 부팅이 거부**됩니다(공개 리포에 박힌 값이라 세션 위조·
#    저장된 시크릿 복호화로 직결). 각각 새 랜덤값으로:
#        openssl rand -hex 32
#    (시크릿마다 서로 다른 값을 쓰세요.)
SECRET_KEY=change-me-to-32-plus-random-bytes-64-hex-recommended
POSTGRES_PASSWORD=change-me-too
PUBLIC_URL=https://bebe.example.com

# DB role 비밀번호 (web/media 권한 분리 — 단일 컨테이너 안에서도 유지). 각각 다른 강한 값.
BEBE_WEB_DB_PASSWORD=change-me-web
BEBE_MEDIA_DB_PASSWORD=change-me-media

# media 서비스 내부 인증 (각각 openssl rand -hex 32)
MEDIA_SERVICE_TOKEN=change-me-service-token
MEDIA_JWT_SECRET=change-me-jwt-secret

# ── Networking ─────────────────────────────────────────────
# 단일 포트. 브라우저는 PUBLIC_URL/media/* 로 미디어에 접근(컨테이너 내부에서
# Next 가 localhost:3001 로 프록시).
PORT=3000
# 아래 두 값은 **비워 두는 것이 기본**(상대경로 사용 → 어떤 접속 경로에서도 이미지가
# 뜬다). 미디어를 별도 도메인/호스트로 분리한 경우에만 그 절대 URL 을 채운다.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
# 리버스 프록시 뒤(기본 true)면 x-real-ip / x-forwarded-for 로 클라이언트 IP 를 본다.
# 프록시 없이 3000 을 직접 노출하면 false — 위조 헤더로 레이트리밋을 우회하지 못하게.
# TRUST_PROXY=true
# 공유 링크 미리보기(OG)에 신뢰할 추가 호스트(쉼표). PUBLIC_URL 이 LAN 주소인데 도메인으로도
# 공유할 때. 기본은 PUBLIC_URL 의 호스트만.
# SHARE_ALLOWED_HOSTS=bebe.example.com

# ── Volumes / 권한 ─────────────────────────────────────────
DATA_DIR=./data
PG_DIR=./pg
REDIS_DIR=./redis
BACKUP_DIR=./backups
PUID=1000
PGID=1000

# ── Admin ──────────────────────────────────────────────────
# 추가 인스턴스 관리자(쉼표 구분). 첫 가입자(owner)는 이 값과 무관하게 관리자다. 이 목록은
# **OIDC 로 검증된 이메일**에만 적용된다 — 아이디/비밀번호 계정의 이메일은 미검증이라 매칭되지 않는다.
ADMIN_USER_EMAIL=you@example.com

# (선택) 첫 소유자 선점 방어. 설정하면 최초 가입에 이 토큰이 필요해져,
# 공개 URL 에 먼저 접속한 사람이 owner/admin 을 차지하는 것을 막는다. 본인은
# https://<host>/signup?setup=<이 값> 으로 접속해 첫 계정을 만든다. (LAN 에서
# 먼저 세팅한 뒤 노출한다면 불필요.) 예: openssl rand -hex 16
# SETUP_TOKEN=

# ── Storage (default local) ────────────────────────────────
STORAGE_MODE=local
# STORAGE_MODE=s3
# STORAGE_S3_ENDPOINT=https://minio.example.com
# STORAGE_S3_BUCKET=bebe
# STORAGE_S3_ACCESS_KEY=...
# STORAGE_S3_SECRET_KEY=...
# STORAGE_S3_REGION=us-east-1

# ── Media processing (optional) ────────────────────────────
# 파생물에 AVIF 포함 여부(기본 true). AVIF 인코딩이 파생물 생성 시간의 대부분을
# 차지한다 — 저사양 NAS·대량 업로드에서 업로드가 느리면 false 로 두면 처리속도가
# 크게 빨라진다. WebP+JPEG 만 생성하고 <picture> 가 자동 폴백(화질 거의 동일, 파일만
# 약간 큼). 기존 AVIF 파생물은 그대로 유지된다.
# MEDIA_DERIVATIVES_INCLUDE_AVIF=false
# 나머지 노브(기본값). compose 의 app.environment 에 같은 이름으로 추가해야 컨테이너에 닿는다
# — 전체 표는 docs/operations.md "Tuning knobs".
# MEDIA_CONCURRENCY_THUMBNAIL=3        # 동시에 처리하는 사진 파생물 잡
# MEDIA_MAX_UPLOAD_BYTES=5368709120    # 파일 하나 상한(5GiB)
# MEDIA_FAMILY_QUOTA_BYTES=0           # 가족 전체 상한, 0=무제한
# MEDIA_MAX_INPUT_PIXELS=64000000      # 이보다 큰 이미지는 거부(디코딩 메모리 보호)
# MEDIA_STALE_UPLOAD_HOURS=0.5         # 이 시간 넘게 진행이 없는 업로드를 failed 처리
# MEDIA_STALE_PROCESSING_HOURS=12      # 이 시간 넘게 processing 인 자산을 failed 처리
# MEDIA_SHUTDOWN_GRACE_MS=30000        # stop 시 진행 중 트랜스코드에 주는 시간

# ── Image ──────────────────────────────────────────────────
TAG=latest
GITHUB_REPO=svrforum/bebe-moment

# ── Logs ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Resource limits (optional) ─────────────────────────────
# 단일 app 컨테이너 = web + media(sharp/ffmpeg) + 알림 워커 합산
APP_MEMORY_LIMIT=2560m
PG_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=128m
# 프로세스별 Node 힙 상한(MB). 합이 APP_MEMORY_LIMIT 아래여야 한다 — sharp/ffmpeg 는 힙 밖에서
# 메모리를 더 쓴다. 8GB 이상 NAS 에서 web 이 자주 느리면 APP_HEAP_WEB_MB 를 올린다.
# APP_HEAP_WEB_MB=768
# APP_HEAP_MEDIA_MB=640
# APP_HEAP_WORKER_MB=256
# Postgres — PG_MEMORY_LIMIT 안에서 맞춘 NAS 기본값. 메모리를 더 주면 함께 올린다
# (shared_buffers ≈ 한도의 1/4~1/2, effective_cache_size ≈ 한도 + OS 캐시).
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE=768MB
# PG_WORK_MEM=8MB

# 알림 시각(방해금지·다이제스트·추억)을 판단할 타임존. 가족이 사는 곳으로.
TZ=Asia/Seoul
