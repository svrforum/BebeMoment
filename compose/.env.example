# ── Required ───────────────────────────────────────────────
SECRET_KEY=change-me-to-32-plus-random-bytes-64-hex-recommended
POSTGRES_PASSWORD=change-me-too
PUBLIC_URL=https://bebe.example.com

# DB role 비밀번호 (web/media 권한 분리 — 단일 컨테이너 안에서도 유지)
BEBE_WEB_DB_PASSWORD=change-me-web
BEBE_MEDIA_DB_PASSWORD=change-me-media

# media 서비스 내부 인증 (랜덤 hex 권장: openssl rand -hex 32)
MEDIA_SERVICE_TOKEN=change-me-service-token
MEDIA_JWT_SECRET=change-me-jwt-secret

# ── Networking ─────────────────────────────────────────────
# 단일 포트. 브라우저는 PUBLIC_URL/media/* 로 미디어에 접근(컨테이너 내부에서
# Next 가 localhost:3001 로 프록시).
PORT=3000
# 아래 두 값은 **비워 두는 것이 기본**(상대경로 사용 → 어떤 접속 경로에서도 이미지가
# 뜬다). 미디어를 별도 도메인/호스트로 분리한 경우에만 그 절대 URL 을 채운다.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com
# MEDIA_PUBLIC_BASE_URL=https://media.example.com

# ── Volumes / 권한 ─────────────────────────────────────────
DATA_DIR=./data
PG_DIR=./pg
REDIS_DIR=./redis
PUID=1000
PGID=1000

# ── Admin ──────────────────────────────────────────────────
ADMIN_USER_EMAIL=you@example.com

# ── Storage (default local) ────────────────────────────────
STORAGE_MODE=local
# STORAGE_MODE=s3
# STORAGE_S3_ENDPOINT=https://minio.example.com
# STORAGE_S3_BUCKET=bebe
# STORAGE_S3_ACCESS_KEY=...
# STORAGE_S3_SECRET_KEY=...
# STORAGE_S3_REGION=us-east-1

# ── Image ──────────────────────────────────────────────────
TAG=latest
GITHUB_REPO=svrforum/bebe-moment

# ── Logs ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Resource limits (optional) ─────────────────────────────
# 단일 app 컨테이너 = web + media(sharp/ffmpeg) 합산
APP_MEMORY_LIMIT=2560m
PG_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=128m

# 알림 시각(방해금지·다이제스트·추억)을 판단할 타임존. 가족이 사는 곳으로.
TZ=Asia/Seoul
