{
  admin off
  auto_https disable_redirects
}

:80 {
  handle /media/* {
    reverse_proxy media:3001 {
      flush_interval -1
      transport http {
        response_header_timeout 0s
        read_timeout 600s
      }
    }
  }

  handle {
    reverse_proxy web:3000
  }

  encode gzip zstd

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
