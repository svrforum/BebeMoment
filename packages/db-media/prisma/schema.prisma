generator client {
  provider        = "prisma-client"
  output          = "./generated/client"
  // Driver-adapter build — see db-public/prisma/schema.prisma for rationale.
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["media"]
}

model Asset {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId                String    @map("family_id") @db.Uuid
  uploadedByUserId        String    @map("uploaded_by_user_id") @db.Uuid

  kind                    AssetKind
  originalKey             String    @map("original_key")
  originalFilename        String    @map("original_filename")
  mimeType                String    @map("mime_type")
  sizeBytes               BigInt    @map("size_bytes")
  sha256                  String    @db.Char(64)
  width                   Int?
  height                  Int?
  durationMs              Int?      @map("duration_ms")

  blurhash                String?  @map("blurhash")
  dominantColor           String?  @map("dominant_color")
  aspectRatioCached       Decimal? @map("aspect_ratio_cached") @db.Decimal(6, 4)

  takenAt                 DateTime  @map("taken_at")
  takenAtSource           TakenAtSource @map("taken_at_source")
  uploadedAt              DateTime  @default(now()) @map("uploaded_at")

  gpsLat                  Float?    @map("gps_lat")
  gpsLng                  Float?    @map("gps_lng")
  cameraMake              String?   @map("camera_make")
  cameraModel             String?   @map("camera_model")
  exifRaw                 Json?     @map("exif_raw")

  originalConvertedFrom   String?   @map("original_converted_from")

  status                  AssetStatus @default(uploading)
  processingError         String?     @map("processing_error")
  derivatives             Json       @default("{}")

  // 중복 업로드(같은 family·sha256)면 워커가 기존(canonical) 자산의 표시 필드를 복사해
  // ready 별칭으로 만들고 이 컬럼에 canonical id 를 기록한다. 타임라인 그리드·미해결
  // 카운트 등 "둘러보기" 목록에서는 제외(duplicate_of IS NULL), 스토리·앨범 등 명시적
  // 참조에서는 정상 표시.
  duplicateOf             String?   @map("duplicate_of") @db.Uuid

  visibility              Visibility @default(family)

  tags                    String[]   @default([])
  caption                 String?

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  assetBabies    AssetBaby[]

  @@unique([familyId, sha256])
  @@index([familyId, takenAt])
  @@index([familyId, status])
  @@index([familyId, status, takenAt, id], map: "assets_timeline_idx")
  @@map("assets")
  @@schema("media")
}

enum AssetKind {
  image
  video
  @@map("asset_kind")
  @@schema("media")
}

enum AssetStatus {
  uploading
  processing
  ready
  failed
  @@map("asset_status")
  @@schema("media")
}

enum TakenAtSource {
  exif
  filename
  filemtime
  manual
  uploaded
  @@map("taken_at_source")
  @@schema("media")
}

enum Visibility {
  private
  family
  @@map("visibility")
  @@schema("media")
}

model AssetBaby {
  assetId           String          @map("asset_id") @db.Uuid
  babyId            String          @map("baby_id") @db.Uuid
  taggedByUserId    String          @map("tagged_by_user_id") @db.Uuid
  taggedAt          DateTime        @default(now()) @map("tagged_at")
  detectionSource   DetectionSource @default(manual) @map("detection_source")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, babyId])
  @@map("asset_babies")
  @@schema("media")
}

enum DetectionSource {
  manual
  ai
  @@map("detection_source")
  @@schema("media")
}
