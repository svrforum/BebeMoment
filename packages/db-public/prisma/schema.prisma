generator client {
  provider        = "prisma-client"
  output          = "./generated/client"
  // Driver-adapter (engineType=client) build — no query-engine binary, so the
  // Alpine/musl binaryTargets workaround from the v5 days is gone. The pg
  // adapter (@prisma/adapter-pg) talks to Postgres directly from JS.
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?  @unique
  username      String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String?  @map("password_hash")
  displayName   String   @map("display_name")
  avatarPath    String?  @map("avatar_path")
  locale        String   @default("ko")
  timezone      String   @default("Asia/Seoul")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships           Membership[]
  sessions              Session[]
  accounts              Account[]
  oidcIdentities        OidcIdentity[]
  createdFamilies       Family[]         @relation("CreatedBy")
  sentInvites           Invite[]         @relation("InvitedBy")
  acceptedInvites       Invite[]         @relation("AcceptedBy")
  updatedSettings       AppSetting[]     @relation("SettingUpdatedBy")
  settingHistory        SettingHistory[]
  createdGrowthRecords  GrowthRecord[]
  createdMilestones     Milestone[]
  createdStories Story[]
  likes                 AssetLike[]
  bookmarks             AssetBookmark[]
  storyBookmarks      StoryBookmark[]
  authoredComments      AssetComment[]
  createdTags           Tag[]            @relation("TagCreatedBy")
  attachedTags          AssetTag[]       @relation("AssetTagAddedBy")
  createdAlbums         Album[]          @relation("AlbumCreatedBy")
  attachedAlbumAssets   AlbumAsset[]     @relation("AlbumAssetAddedBy")
  attachedAlbumEntries  AlbumStory[] @relation("AlbumEntryAddedBy")
  pushSubscriptions     PushSubscription[]
  notificationPrefs     NotificationPref[]
  devicePushTokens      DevicePushToken[]
  suspendedMemberships Membership[]         @relation("MembershipSuspendedBy")
  passwordResetTokens  PasswordResetToken[] @relation("PasswordResetUser")
  issuedPasswordResets PasswordResetToken[] @relation("PasswordResetIssuedBy")
  widgetToken          WidgetToken?
  appAuthHandoffs      AppAuthHandoff[]

  @@map("users")
  @@schema("public")
}

model WidgetToken {
  token               String    @id
  userId              String    @unique @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now()) @map("created_at")
  lastUsedAt          DateTime? @map("last_used_at")
  // 위젯 사진 소스: 'recent'(전체 최신·기본) | 'bookmark_random' | 'bookmark_pinned'
  widgetSource        String    @default("recent") @map("widget_source")
  widgetPinnedAssetId String?   @map("widget_pinned_asset_id") @db.Uuid

  @@map("widget_tokens")
  @@schema("public")
}

model Session {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token           String   @unique
  userId          String   @map("user_id") @db.Uuid
  currentFamilyId String?  @map("current_family_id") @db.Uuid
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [currentFamilyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("public")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
  @@schema("public")
}

model OidcProvider {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  // 'oidc' = 표준 OIDC(discovery + id_token + JWKS). 'naver' = 네이버 OAuth2 전용
  // (discovery·id_token 없음, 고정 엔드포인트 + nid/me userinfo 언랩).
  kind                  String   @default("oidc")
  issuer                String
  clientId              String   @map("client_id")
  clientSecretEnc       String   @map("client_secret_enc")
  authorizationEndpoint String?  @map("authorization_endpoint")
  tokenEndpoint         String?  @map("token_endpoint")
  userinfoEndpoint      String?  @map("userinfo_endpoint")
  jwksUri               String?  @map("jwks_uri")
  scopes                String[] @default(["openid", "email", "profile"])
  enabled               Boolean  @default(true)
  lockedByEnv           Boolean  @default(false) @map("locked_by_env")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  identities OidcIdentity[]

  @@map("oidc_providers")
  @@schema("public")
}

model OidcIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  subject    String
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider OidcProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@map("oidc_identities")
  @@schema("public")
}

model Family {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  createdBy      User            @relation("CreatedBy", fields: [createdByUserId], references: [id])
  memberships    Membership[]
  invites        Invite[]
  babies         Baby[]
  sessions       Session[]
  growthRecords  GrowthRecord[]
  milestones     Milestone[]
  stories Story[]
  assetLikes       AssetLike[]
  assetBookmarks   AssetBookmark[]
  storyBookmarks StoryBookmark[]
  assetComments    AssetComment[]
  tags             Tag[]
  assetTags      AssetTag[]
  albums         Album[]
  albumAssets    AlbumAsset[]
  albumEntries   AlbumStory[]

  @@map("families")
  @@schema("public")
}

model Membership {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       Role
  joinedAt   DateTime  @default(now()) @map("joined_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  lastSeenAt DateTime? @map("last_seen_at")
  suspendedAt       DateTime? @map("suspended_at")
  suspendedReason   String?   @map("suspended_reason")
  suspendedByUserId String?   @map("suspended_by_user_id") @db.Uuid

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspendedBy User? @relation("MembershipSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("public")
}

model PasswordResetToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String    @unique
  userId         String    @map("user_id") @db.Uuid
  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user     User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("PasswordResetIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, usedAt])
  @@index([token])
  @@map("password_reset_tokens")
  @@schema("public")
}

// SNS 앱-로그인(Custom Tab) 핸드오프 — 외부 브라우저 OIDC 완료 후 발급되는 1회용 코드.
// 앱이 deep link 로 받아 verifier(PKCE식)와 함께 교환해 WebView 세션 쿠키를 받는다.
// user-scoped(테넌트 미적용).
model AppAuthHandoff {
  code            String   @id
  userId          String   @map("user_id") @db.Uuid
  currentFamilyId String?  @map("current_family_id") @db.Uuid
  verifierHash    String   @map("verifier_hash")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("app_auth_handoffs")
  @@schema("public")
}

enum Role {
  owner
  guardian
  family

  @@map("role")
  @@schema("public")
}

model Invite {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId     String     @map("family_id") @db.Uuid
  invitedById  String     @map("invited_by_id") @db.Uuid
  email        String?
  role         InviteRole
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  acceptedAt   DateTime?  @map("accepted_at")
  acceptedById String?    @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy  User   @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?  @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([familyId])
  @@map("invites")
  @@schema("public")
}

enum InviteRole {
  guardian
  family

  @@map("invite_role")
  @@schema("public")
}

model Baby {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  name           String
  birthDate      DateTime  @map("birth_date") @db.Date
  birthTime      String?   @map("birth_time")
  gender         Gender?
  profileAssetId String?   @map("profile_asset_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  family         Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  growthRecords  GrowthRecord[]
  milestones     Milestone[]
  stories Story[]

  @@index([familyId])
  @@map("babies")
  @@schema("public")
}

enum Gender {
  male
  female
  other
  unspecified

  @@map("gender")
  @@schema("public")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("app_settings")
  @@schema("public")
}

model SettingHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  user User? @relation(fields: [changedBy], references: [id])

  @@index([key])
  @@map("setting_history")
  @@schema("public")
}

model GrowthRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  babyId          String    @map("baby_id") @db.Uuid
  measuredAt      DateTime  @map("measured_at") @db.Date
  heightCm        Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg        Decimal?  @map("weight_kg") @db.Decimal(5, 3)
  headCm          Decimal?  @map("head_cm") @db.Decimal(5, 2)
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby   @relation(fields: [babyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, babyId, measuredAt])
  @@map("growth_records")
  @@schema("public")
}

model Milestone {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  babyId          String    @map("baby_id") @db.Uuid
  presetKey       String?   @map("preset_key")
  customLabel     String?   @map("custom_label")
  achievedAt      DateTime  @map("achieved_at") @db.Date
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby             @relation(fields: [babyId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdByUserId], references: [id])
  assets    MilestoneAsset[]

  @@unique([familyId, babyId, presetKey])
  @@index([familyId, babyId, achievedAt])
  @@map("milestones")
  @@schema("public")
}

model MilestoneAsset {
  milestoneId String @map("milestone_id") @db.Uuid
  assetId     String @map("asset_id") @db.Uuid

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([milestoneId, assetId])
  @@map("milestone_assets")
  @@schema("public")
}

model Story {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicNo        Int                @unique @default(dbgenerated("nextval('public.stories_public_no_seq')")) @map("public_no")
  familyId        String             @map("family_id") @db.Uuid
  babyId          String?            @map("baby_id") @db.Uuid
  entryDate       DateTime           @map("entry_date") @db.Date
  title           String?
  body            String
  mood            String?
  visibility      StoryVisibility  @default(family)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  family    Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby?               @relation(fields: [babyId], references: [id], onDelete: SetNull)
  createdBy User                @relation(fields: [createdByUserId], references: [id])
  assets    StoryAsset[]
  albums    AlbumStory[]
  bookmarks StoryBookmark[]

  @@index([familyId, entryDate])
  @@index([familyId, babyId, entryDate])
  @@index([familyId, visibility, entryDate(sort: Desc)])
  @@map("stories")
  @@schema("public")
}

enum StoryVisibility {
  family
  guardians
  @@map("story_visibility")
  @@schema("public")
}

model StoryAsset {
  entryId String @map("entry_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  order   Int    @default(0)

  entry Story @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, assetId])
  // assetId-leading 역조회(타임라인 모델 B·캘린더가 assetId IN (...) 로 스토리 찾음)는
  // 복합 PK 로 인덱스를 못 타 풀스캔이었다 → 단독 인덱스.
  @@index([assetId])
  @@map("story_assets")
  @@schema("public")
}

model AssetLike {
  assetId   String   @map("asset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@index([familyId, userId])
  @@map("asset_likes")
  @@schema("public")
}

model AssetBookmark {
  assetId   String   @map("asset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@index([familyId, userId, createdAt])
  @@map("asset_bookmarks")
  @@schema("public")
}

model StoryBookmark {
  entryId   String   @map("entry_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entry  Story @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, userId])
  @@index([familyId, userId, createdAt])
  @@map("story_bookmarks")
  @@schema("public")
}

// 스토리 공유 링크. token = 예측 불가 난수(PK). 영구(expiresAt=null) 또는 기간제, revoke 가능.
// DB FK(story/family, ON DELETE CASCADE)는 마이그레이션에만 — Prisma 관계로는 모델하지 않음
// (back-relation 불필요, 공개 라우트는 token raw 조회). family_id 로 tenant-scoped.
model ShareLink {
  token           String    @id
  familyId        String    @map("family_id") @db.Uuid
  storyId         String?   @map("story_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  albumId         String?   @map("album_id") @db.Uuid
  targetDate      DateTime? @map("target_date") @db.Date
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastAccessedAt  DateTime? @map("last_accessed_at")

  @@index([familyId, storyId])
  @@index([familyId, assetId])
  @@index([familyId, albumId])
  @@map("share_links")
  @@schema("public")
}

model AssetComment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  authorUserId     String    @map("author_user_id") @db.Uuid
  body             String
  mentionedUserIds String[]  @map("mentioned_user_ids") @db.Uuid
  editedAt         DateTime? @map("edited_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id])

  @@index([familyId, assetId, createdAt])
  @@index([authorUserId])
  @@map("asset_comments")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase D — Tags + Albums.
// Same pattern as AssetLike/AssetBookmark/AssetComment: lives in public,
// references media.assets only by uuid (no enforced FK).

model Tag {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  name            String
  slug            String
  color           String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User       @relation("TagCreatedBy", fields: [createdByUserId], references: [id])
  assetTags AssetTag[]

  @@index([familyId, deletedAt])
  @@map("tags")
  @@schema("public")
}

model AssetTag {
  assetId        String   @map("asset_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  addedAt        DateTime @default(now()) @map("added_at")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy User   @relation("AssetTagAddedBy", fields: [addedByUserId], references: [id])

  @@id([assetId, tagId])
  @@index([tagId])
  @@index([familyId, assetId])
  @@map("asset_tags")
  @@schema("public")
}

model Album {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  name            String
  description     String?
  coverAssetId    String?   @map("cover_asset_id") @db.Uuid
  /// 비밀 앨범 — owner/guardian(부모) 만 보임. family 역할에겐 목록·트리·상세 모두 숨김.
  secret          Boolean   @default(false) @map("is_secret")
  sortIndex       Int       @default(0) @map("sort_index")
  /// Materialized path: slash-separated album uuids ending with this id.
  /// Maintained in app inside the same transaction as parent_id changes.
  path            String
  depth           Int       @default(0)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent    Album?       @relation("AlbumTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Album[]      @relation("AlbumTree")
  createdBy User         @relation("AlbumCreatedBy", fields: [createdByUserId], references: [id])
  assets    AlbumAsset[]
  entries   AlbumStory[]

  @@index([familyId, parentId, deletedAt])
  @@map("albums")
  @@schema("public")
}

model AlbumAsset {
  albumId       String   @map("album_id") @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  familyId      String   @map("family_id") @db.Uuid
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at")
  sortIndex     Int      @default(0) @map("sort_index")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  addedBy User   @relation("AlbumAssetAddedBy", fields: [addedByUserId], references: [id])

  @@id([albumId, assetId])
  @@index([assetId])
  @@index([familyId, albumId, sortIndex])
  @@map("album_assets")
  @@schema("public")
}

model AlbumStory {
  albumId        String   @map("album_id") @db.Uuid
  storyId String   @map("story_id") @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  addedAt        DateTime @default(now()) @map("added_at")
  sortIndex      Int      @default(0) @map("sort_index")

  family  Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  album   Album        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  entry   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  addedBy User         @relation("AlbumEntryAddedBy", fields: [addedByUserId], references: [id])

  @@id([albumId, storyId])
  @@index([storyId])
  @@index([familyId, albumId, sortIndex])
  @@map("album_stories")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// Push notifications — scoped by userId (not family), like Session.

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("public")
}

model NotificationPref {
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  enabled  Boolean @default(true)

  @@id([userId, category])
  @@map("notification_prefs")
  @@schema("public")
}

model DevicePushToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String   @default("android")
  token      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([userId])
  @@map("device_push_tokens")
  @@schema("public")
}
