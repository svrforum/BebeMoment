generator client {
  provider        = "prisma-client"
  output          = "./generated/client"
  // Driver-adapter (engineType=client) build — no query-engine binary, so the
  // Alpine/musl binaryTargets workaround from the v5 days is gone. The pg
  // adapter (@prisma/adapter-pg) talks to Postgres directly from JS.
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String?  @map("password_hash")
  displayName   String   @map("display_name")
  avatarPath    String?  @map("avatar_path")
  locale        String   @default("ko")
  timezone      String   @default("Asia/Seoul")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships           Membership[]
  sessions              Session[]
  accounts              Account[]
  oidcIdentities        OidcIdentity[]
  createdFamilies       Family[]         @relation("CreatedBy")
  sentInvites           Invite[]         @relation("InvitedBy")
  acceptedInvites       Invite[]         @relation("AcceptedBy")
  updatedSettings       AppSetting[]     @relation("SettingUpdatedBy")
  settingHistory        SettingHistory[]
  createdGrowthRecords  GrowthRecord[]
  createdMilestones     Milestone[]
  createdJournalEntries JournalEntry[]
  likes                 AssetLike[]
  bookmarks             AssetBookmark[]
  authoredComments      AssetComment[]
  createdTags           Tag[]            @relation("TagCreatedBy")
  attachedTags          AssetTag[]       @relation("AssetTagAddedBy")
  createdAlbums         Album[]          @relation("AlbumCreatedBy")
  attachedAlbumAssets   AlbumAsset[]     @relation("AlbumAssetAddedBy")
  pushSubscriptions     PushSubscription[]
  notificationPrefs     NotificationPref[]

  @@map("users")
  @@schema("public")
}

model Session {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token           String   @unique
  userId          String   @map("user_id") @db.Uuid
  currentFamilyId String?  @map("current_family_id") @db.Uuid
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [currentFamilyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
  @@schema("public")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("public")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
  @@schema("public")
}

model OidcProvider {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  issuer                String
  clientId              String   @map("client_id")
  clientSecretEnc       String   @map("client_secret_enc")
  authorizationEndpoint String?  @map("authorization_endpoint")
  tokenEndpoint         String?  @map("token_endpoint")
  userinfoEndpoint      String?  @map("userinfo_endpoint")
  jwksUri               String?  @map("jwks_uri")
  scopes                String[] @default(["openid", "email", "profile"])
  enabled               Boolean  @default(true)
  lockedByEnv           Boolean  @default(false) @map("locked_by_env")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  identities OidcIdentity[]

  @@map("oidc_providers")
  @@schema("public")
}

model OidcIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  subject    String
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider OidcProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@map("oidc_identities")
  @@schema("public")
}

model Family {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  createdBy      User            @relation("CreatedBy", fields: [createdByUserId], references: [id])
  memberships    Membership[]
  invites        Invite[]
  babies         Baby[]
  sessions       Session[]
  growthRecords  GrowthRecord[]
  milestones     Milestone[]
  journalEntries JournalEntry[]
  assetLikes     AssetLike[]
  assetBookmarks AssetBookmark[]
  assetComments  AssetComment[]
  tags           Tag[]
  assetTags      AssetTag[]
  albums         Album[]
  albumAssets    AlbumAsset[]

  @@map("families")
  @@schema("public")
}

model Membership {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      Role
  joinedAt  DateTime  @default(now()) @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("public")
}

enum Role {
  owner
  guardian
  family

  @@map("role")
  @@schema("public")
}

model Invite {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId     String     @map("family_id") @db.Uuid
  invitedById  String     @map("invited_by_id") @db.Uuid
  email        String
  role         InviteRole
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  acceptedAt   DateTime?  @map("accepted_at")
  acceptedById String?    @map("accepted_by_id") @db.Uuid
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy  User   @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?  @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([familyId])
  @@map("invites")
  @@schema("public")
}

enum InviteRole {
  guardian
  family

  @@map("invite_role")
  @@schema("public")
}

model Baby {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  name           String
  birthDate      DateTime  @map("birth_date") @db.Date
  birthTime      String?   @map("birth_time")
  gender         Gender?
  profileAssetId String?   @map("profile_asset_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  family         Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  growthRecords  GrowthRecord[]
  milestones     Milestone[]
  journalEntries JournalEntry[]

  @@index([familyId])
  @@map("babies")
  @@schema("public")
}

enum Gender {
  male
  female
  other
  unspecified

  @@map("gender")
  @@schema("public")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("app_settings")
  @@schema("public")
}

model SettingHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  changedBy String?  @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  user User? @relation(fields: [changedBy], references: [id])

  @@index([key])
  @@map("setting_history")
  @@schema("public")
}

model GrowthRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  babyId          String    @map("baby_id") @db.Uuid
  measuredAt      DateTime  @map("measured_at") @db.Date
  heightCm        Decimal?  @map("height_cm") @db.Decimal(5, 2)
  weightKg        Decimal?  @map("weight_kg") @db.Decimal(5, 3)
  headCm          Decimal?  @map("head_cm") @db.Decimal(5, 2)
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby   @relation(fields: [babyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  @@index([familyId, babyId, measuredAt])
  @@map("growth_records")
  @@schema("public")
}

model Milestone {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  babyId          String    @map("baby_id") @db.Uuid
  presetKey       String?   @map("preset_key")
  customLabel     String?   @map("custom_label")
  achievedAt      DateTime  @map("achieved_at") @db.Date
  note            String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby             @relation(fields: [babyId], references: [id], onDelete: Cascade)
  createdBy User             @relation(fields: [createdByUserId], references: [id])
  assets    MilestoneAsset[]

  @@unique([familyId, babyId, presetKey])
  @@index([familyId, babyId, achievedAt])
  @@map("milestones")
  @@schema("public")
}

model MilestoneAsset {
  milestoneId String @map("milestone_id") @db.Uuid
  assetId     String @map("asset_id") @db.Uuid

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([milestoneId, assetId])
  @@map("milestone_assets")
  @@schema("public")
}

model JournalEntry {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String             @map("family_id") @db.Uuid
  babyId          String?            @map("baby_id") @db.Uuid
  entryDate       DateTime           @map("entry_date") @db.Date
  title           String?
  body            String
  mood            String?
  visibility      JournalVisibility  @default(family)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  family    Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  baby      Baby?               @relation(fields: [babyId], references: [id], onDelete: SetNull)
  createdBy User                @relation(fields: [createdByUserId], references: [id])
  assets    JournalEntryAsset[]

  @@index([familyId, entryDate])
  @@index([familyId, babyId, entryDate])
  @@index([familyId, visibility, entryDate(sort: Desc)])
  @@map("journal_entries")
  @@schema("public")
}

enum JournalVisibility {
  family
  guardians
  @@map("journal_visibility")
  @@schema("public")
}

model JournalEntryAsset {
  entryId String @map("entry_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  order   Int    @default(0)

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, assetId])
  @@map("journal_entry_assets")
  @@schema("public")
}

model AssetLike {
  assetId   String   @map("asset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@index([familyId, userId])
  @@map("asset_likes")
  @@schema("public")
}

model AssetBookmark {
  assetId   String   @map("asset_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@index([familyId, userId, createdAt])
  @@map("asset_bookmarks")
  @@schema("public")
}

model AssetComment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  authorUserId     String    @map("author_user_id") @db.Uuid
  body             String
  mentionedUserIds String[]  @map("mentioned_user_ids") @db.Uuid
  editedAt         DateTime? @map("edited_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id])

  @@index([familyId, assetId, createdAt])
  @@index([authorUserId])
  @@map("asset_comments")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase D — Tags + Albums.
// Same pattern as AssetLike/AssetBookmark/AssetComment: lives in public,
// references media.assets only by uuid (no enforced FK).

model Tag {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  name            String
  slug            String
  color           String?
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User       @relation("TagCreatedBy", fields: [createdByUserId], references: [id])
  assetTags AssetTag[]

  @@index([familyId, deletedAt])
  @@map("tags")
  @@schema("public")
}

model AssetTag {
  assetId        String   @map("asset_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  addedAt        DateTime @default(now()) @map("added_at")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy User   @relation("AssetTagAddedBy", fields: [addedByUserId], references: [id])

  @@id([assetId, tagId])
  @@index([tagId])
  @@index([familyId, assetId])
  @@map("asset_tags")
  @@schema("public")
}

model Album {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  parentId        String?   @map("parent_id") @db.Uuid
  name            String
  description     String?
  coverAssetId    String?   @map("cover_asset_id") @db.Uuid
  sortIndex       Int       @default(0) @map("sort_index")
  /// Materialized path: slash-separated album uuids ending with this id.
  /// Maintained in app inside the same transaction as parent_id changes.
  path            String
  depth           Int       @default(0)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent    Album?       @relation("AlbumTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Album[]      @relation("AlbumTree")
  createdBy User         @relation("AlbumCreatedBy", fields: [createdByUserId], references: [id])
  assets    AlbumAsset[]

  @@index([familyId, parentId, deletedAt])
  @@map("albums")
  @@schema("public")
}

model AlbumAsset {
  albumId       String   @map("album_id") @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  familyId      String   @map("family_id") @db.Uuid
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  addedAt       DateTime @default(now()) @map("added_at")
  sortIndex     Int      @default(0) @map("sort_index")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  addedBy User   @relation("AlbumAssetAddedBy", fields: [addedByUserId], references: [id])

  @@id([albumId, assetId])
  @@index([assetId])
  @@index([familyId, albumId, sortIndex])
  @@map("album_assets")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────
// Push notifications — scoped by userId (not family), like Session.

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("public")
}

model NotificationPref {
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  enabled  Boolean @default(true)

  @@id([userId, category])
  @@map("notification_prefs")
  @@schema("public")
}
