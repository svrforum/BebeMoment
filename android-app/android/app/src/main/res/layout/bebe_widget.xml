<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <!-- RemoteViews 는 일반 <View> 를 지원하지 않음(허용 목록: ImageView/TextView/…).
         가독성용 하단 그라데이션은 ImageView 로 깐다. -->
    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:singleLine="true"
            android:text="" />

        <TextView
            android:id="@+id/widget_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:singleLine="true"
            android:text="" />
    </LinearLayout>

    <!-- 새로고침(랜덤) 버튼 — 탭하면 캐시된 사진 중 무작위로 바뀜. 사진 2장 이상일 때만
         코드에서 visibility 로 노출. -->
    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:padding="7dp"
        android:background="@drawable/widget_icon_bg"
        android:src="@drawable/widget_refresh"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/app_name" />

    <!-- 모드 토글(그리드↔큰사진) — 4장(3×3) 위젯에서만 코드가 노출. 새로고침 버튼 왼쪽. -->
    <ImageView
        android:id="@+id/widget_mode"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="50dp"
        android:padding="7dp"
        android:background="@drawable/widget_icon_bg"
        android:src="@drawable/widget_mode_grid"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:minWidth="20dp"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/widget_badge_bg"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="" />

    <!-- 현재 보여주는 사진의 촬영일(좌상단). 코드에서 visibility 제어. -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:shadowColor="#A0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:singleLine="true"
        android:visibility="gone"
        android:text="" />
</FrameLayout>
