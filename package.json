{
  "name": "bebe-moment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:lines": "scripts/check-line-limit.sh",
    "db:migrate": "pnpm --filter @bebe/db-public migrate:dev && pnpm --filter @bebe/db-media migrate:dev",
    "db:studio": "pnpm --filter @bebe/db-public studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  }
}
