{
  "name": "bebe-moment",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:lines": "scripts/check-line-limit.sh",
    "licenses": "pnpm licenses list --prod",
    "licenses:check": "scripts/check-licenses.sh",
    "db:migrate": "pnpm --filter @bebe/db-public migrate:dev && pnpm --filter @bebe/db-media migrate:dev",
    "db:studio": "pnpm --filter @bebe/db-public studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
