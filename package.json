{
  "name": "bebe-moment",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:lines": "scripts/check-line-limit.sh",
    "licenses": "pnpm licenses list --prod",
    "licenses:check": "scripts/check-licenses.sh",
    "db:migrate": "pnpm --filter @bebe/db-public migrate:deploy && pnpm --filter @bebe/db-public generate && pnpm --filter @bebe/db-media migrate:deploy && pnpm --filter @bebe/db-media generate",
    "db:studio": "pnpm --filter @bebe/db-public studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
