{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/coverage",
      "!**/.turbo",
      "!**/build",
      "!**/generated",
      "!**/next-env.d.ts",
      // android-app is a separate Capacitor sub-project (vanilla JS, npm, outside the pnpm workspace)
      "!**/android-app",
      // AI 어시스턴트 설정/스킬 (gitignore 대상, 소스 아님)
      "!**/.claude",
      "!**/*.md",
      // 런타임 볼륨(compose 가 ./data·./pg·./redis·./backups 로 마운트). 반드시 루트 기준 경로로 —
      // "!**/data" 처럼 두면 app/api/widget/data·app/api/admin/backups 의 라우트까지 린트·포맷에서 빠진다.
      "!data",
      "!pg",
      "!redis",
      "!backups",
      "!compose/data",
      "!compose/pg",
      "!compose/redis",
      "!compose/backups",
      // 로컬 개발 데이터(라이브 DB 볼륨·브랜드 원본 SVG 등) — gitignore 대상이라 CI 에는 없다.
      "!.dev",
      "!**/apps/web/public/sw.js",
      "!**/apps/web/public/sw.js.map",
      "!**/apps/web/public/workbox-*.js",
      "!**/apps/web/public/workbox-*.js.map",
      "!**/apps/web/public/swe-worker-*.js",
      "!**/apps/web/public/swe-worker-*.js.map",
      "!**/e2e/test-results",
      "!**/e2e/playwright-report"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Biome 2's import-sort reorders specifiers differently than 1.9 (234 files); off to avoid churn-only diffs.
        "organizeImports": "off"
      }
    }
  },
  "yaml": {
    // biome 2.6 부터 YAML 도 포맷한다. 손으로 다듬은 compose(Synology 에 그대로 붙여넣는다)·
    // 워크플로를 포매터 스타일로 갈아엎는 diff 만 생기므로 끈다.
    "formatter": { "enabled": false }
  },
  "css": {
    "parser": {
      // globals.css uses Tailwind v4 directives (@theme, @custom-variant, @apply); without this the CSS parser errors on them.
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // New biome 2 rules, too opinionated for intentional patterns here (drag-drop dropzone div,
        // aria-label on blurhash/placeholder spans/divs). They also cascade into each other, so off.
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off",
        // click-to-dismiss backdrop overlays use div onClick; the modals keep a
        // keyboard-accessible close (X) button, so this rule is noise here.
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "performance": {
        // 서버가 준 사진은 PictureImage(형식 협상·placeholder)로만 그린다. 예외(로컬 미리보기·
        // 아바타·QR·Swiper Zoom 등)는 그 자리에 무시 주석과 사유를 단다.
        "noImgElement": "error"
      }
    }
  }
}
